{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexlabs:approval-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "actor_id",
    "approver_id",
    "approver_kind",
    "approver_role",
    "action",
    "target_id",
    "tenant_id",
    "payload_sha256",
    "policy_sha256",
    "evidence_refs",
    "max_spend_usd",
    "nonce",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "approver_id": {
      "type": "string"
    },
    "approver_kind": {
      "const": "human"
    },
    "action": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "max_spend_usd": {
      "const": "0"
    },
    "nonce": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approver_role": {
      "enum": [
        "OWNER",
        "AUTHORIZED_REVIEWER"
      ]
    }
  }
}
