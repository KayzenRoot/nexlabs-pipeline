  "required": [
    "reference_id",
    "provider_id",
    "tenant_id",
    "project_id",
    "purpose",
    "version"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "not": {
        "const": "latest"
      }
    }
  }
}
