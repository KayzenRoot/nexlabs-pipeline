{
  "schema": "nexlabs.security-policy.v1",
  "mode": "OFFLINE_CONTRACT_ONLY",
  "policy_epoch": 1,
  "default_effect": "DENY",
  "max_additional_spend_usd": "0",
  "external_effects": "DENY",
  "identity": {
    "required_claims": [
      "principal_id",
      "kind",
      "tenant_id",
      "project_id",
      "host_id",
      "policy_epoch"
    ],
    "allow_role_inheritance": false,
    "hierarchy_grants": false,
    "tenant_match": "EXACT"
  },
  "authorization": {
    "grant_dimensions": [
      "principal_id",
      "action",
      "target_id",
      "tenant_id",
      "project_id",
      "task_id",
      "workflow_id",
      "skill_id",
      "host_id",
      "provider_id",
      "risk",
      "policy_sha256",
      "policy_epoch"
    ],
    "unknown_claims": "DENY",
    "revoked_grants": "DENY",
    "expired_grants": "DENY",
    "stale_policy": "DENY",
    "grant_inheritance": false
  },
  "approvals": {
    "required_for": [
      "HIGH_ASSURANCE"
    ],
    "approver_kind": "human",
    "self_approval": false,
    "binds": [
      "actor_id",
      "action",
      "target_id",
      "tenant_id",
      "payload_sha256",
      "policy_sha256",
      "evidence_refs",
      "max_spend_usd",
      "nonce",
      "issued_at",
      "expires_at"
    ],
    "signature_verifier": "PLUGGABLE_UNSELECTED",
    "nonce_store": "DURABLE_PROVIDER_REQUIRED",
    "hmac_adapter": "TEST_ONLY",
    "authorized_roles": [
      "OWNER",
      "AUTHORIZED_REVIEWER"
    ]
  },
  "network": {
    "transport": null,
    "allowed_cidrs": [],
    "peers": [],
    "services": [],
    "public_routes": false,
    "wildcard_binds": false,
    "live_configuration": false
  },
  "secrets": {
    "provider_candidates": [],
    "opaque_references_only": true,
    "resolve_values": false,
    "create_or_rotate": false,
    "export_to_agents": false
  },
  "isolation": {
    "workspace_scope": [
      "tenant_id",
      "project_id",
      "task_id"
    ],
    "symlink_policy": "DENY",
    "reparse_policy": "DENY",
    "cross_tenant": "DENY",
    "host_mounts": "DENY",
    "docker_socket": "DENY"
  }
}
