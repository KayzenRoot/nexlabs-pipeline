# Non-secret local configuration example. Never put real secrets in this file.
# The PowerShell scripts pass the protected secrets file via --env-file and set
# the data path explicitly.
PAPERCLIP_PORT=3100
PAPERCLIP_BIND_ADDRESS=127.0.0.1
# Absolute path with forward slashes, for example:
# PAPERCLIP_DATA_DIR=D:/NexLabs/Paperclip/data
# The two secrets are generated outside Git by:
# scripts/windows/Initialize-PaperclipSecrets.ps1
