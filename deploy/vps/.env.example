# Future VPS configuration example. Do not deploy from this Windows host.
# Replace every CHANGE_ME value on the VPS, outside Git, with an independent
# secret. The DATABASE_URL password must match POSTGRES_PASSWORD and be URL-safe.
PAPERCLIP_PORT=3100
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE
POSTGRES_DB=paperclip
DATABASE_URL=postgres://paperclip:CHANGE_ME_URL_SAFE@db:5432/paperclip
POSTGRES_DATA_DIR=/srv/nexlabs/paperclip/postgres
PAPERCLIP_DATA_DIR=/srv/nexlabs/paperclip/data
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100
