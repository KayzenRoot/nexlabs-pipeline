{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexlabs:workflow-command:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "run_id", "tenant_id", "project_id", "task_id", "workflow_id", "principal_id", "action", "target_id", "payload_sha256", "risk", "policy_sha256", "policy_epoch", "expected_revision"],
  "properties": {
    "operation": {"type": "string"},
    "run_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "project_id": {"type": "string"},
    "task_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "principal_id": {"type": "string"},
    "action": {"type": "string"},
    "target_id": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk": {"type": "string"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_epoch": {"type": "integer", "minimum": 1},
    "expected_revision": {"type": "integer", "minimum": 0}
  }
}
