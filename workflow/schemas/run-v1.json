{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexlabs:workflow-run:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workflow_id", "workflow_version", "run_id",
    "correlation_id", "event_id", "tenant_id", "project_id", "task_id",
    "idempotency_key", "source_lock", "agent_id", "skill_lock", "model_id",
    "quota", "data_classification", "risk", "inputs_ref", "output_ref",
    "evidence_ref", "deadline", "approval_ref", "status", "state", "revision",
    "attempts", "gate", "activation", "stale", "revoked", "lease_owner",
    "lease_epoch"
  ],
  "properties": {
    "schema_version": {"const": "nexlabs.workflow-run.v1"},
    "workflow_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "run_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "event_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "project_id": {"type": "string"},
    "task_id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "source_lock": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agent_id": {"type": "string"},
    "skill_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model_id": {"type": ["string", "null"]},
    "quota": {"type": "integer", "minimum": 0},
    "data_classification": {
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
    },
    "risk": {"enum": ["LOW", "STANDARD", "ELEVATED", "HIGH_ASSURANCE"]},
    "inputs_ref": {"type": "string"},
    "output_ref": {"type": ["string", "null"]},
    "evidence_ref": {"type": ["string", "null"]},
    "deadline": {"type": "string", "format": "date-time"},
    "approval_ref": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "state": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "gate": {"enum": ["INTERNAL_ONLY", "POLICY_GATED_EXTERNAL", "HUMAN_APPROVAL_REQUIRED"]},
    "activation": {"const": "DISABLED"},
    "stale": {"type": "boolean"},
    "revoked": {"type": "boolean"},
    "lease_owner": {"type": ["string", "null"]},
    "lease_epoch": {"type": "integer", "minimum": 0}
  }
}
