{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexlabs:workflow-run:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "tenant_id", "project_id", "task_id", "workflow_id", "workflow_version", "event_id", "correlation_id", "state", "revision", "attempts", "source_lock_sha256", "deadline_at", "risk", "stale", "revoked", "approval_id", "lease_owner", "lease_epoch"],
  "properties": {
    "run_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "project_id": {"type": "string"},
    "task_id": {"type": "string"},
    "workflow_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "event_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "state": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "attempts": {"type": "integer", "minimum": 0},
    "source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "risk": {"enum": ["LOW", "STANDARD", "ELEVATED", "HIGH_ASSURANCE"]},
    "stale": {"type": "boolean"},
    "revoked": {"type": "boolean"},
    "approval_id": {"type": ["string", "null"]},
    "lease_owner": {"type": ["string", "null"]},
    "lease_epoch": {"type": "integer", "minimum": 0}
  }
}
